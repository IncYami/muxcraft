digraph ChapterCutFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", label="Muxcraft: chapter-based episode cut", labelloc=t, fontsize=22, fontcolor="#14243a"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#8297b0", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.11"];
  edge [color="#64748b", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

  toml [label="Batch TOML\n[episodes] entry", fillcolor="#dceeff"];
  plan [label="Rust: load config, expand paths,\nbuild episode plan"];
  cut [shape=diamond, label="start_chapter\npresent?", fillcolor="#fff2cc"];
  no_cut [label="Use configured source; standard mux\npath outside this diagram", fillcolor="#f3f4f6"];
  discover [label="Rust: find matching MPLS\nin BDMV/PLAYLIST"];
  marks [label="Rust: read 45 kHz chapter marks\nand select interval"];
  probe [label="ffprobe: H.264, source start time,\nnearby keyframes", fillcolor="#e0f4f4"];
  bounds [shape=diamond, label="Valid boundaries\nwithin one frame?", fillcolor="#fff2cc"];
  interval [label="Resolved episode interval", fillcolor="#dceeff"];
  error [label="Stop episode; write error to audit if enabled", fillcolor="#ffe1e1", color="#c76d6d"];

  subgraph cluster_video {
    label="Video"; color="#a8c8ef"; style="rounded"; fontname="DejaVu Sans";
    video [label="ffmpeg tee: write exact frame count to MKV\nand hash source H.264 picture units", fillcolor="#e8f1ff"];
    video_hash [label="ffmpeg: independently hash saved cut MKV\npicture units and compare packet count", fillcolor="#e8f1ff"];
    video_ok [shape=diamond, label="Integrity\npasses?", fillcolor="#fff2cc"];
    video -> video_hash -> video_ok;
  }
  subgraph cluster_audio {
    label="Audio"; color="#a9d8b8"; style="rounded"; fontname="DejaVu Sans";
    audio [label="ffmpeg: one source read; asplit to timestamp-trimmed\nWAV and sample-trimmed PCM", fillcolor="#e7f7ed"];
    audio_hash [label="Rust hashes sample-count PCM branch; independently\nhash saved WAV and compare", fillcolor="#e7f7ed"];
    audio_ok [shape=diamond, label="Source and cut\nPCM match?", fillcolor="#fff2cc"];
    flac [label="flac: encode WAV\n-8 --verify", fillcolor="#e7f7ed"];
    audio -> audio_hash -> audio_ok;
    audio_ok -> flac [label="yes"];
  }
  subgraph cluster_pgs {
    label="PGS, if configured"; color="#ccb4e8"; style="rounded"; fontname="DejaVu Sans";
    pgs [label="ffmpeg: extract complete\nPGS stream to SUP", fillcolor="#f3eaff"];
    pgs_cut [label="Rust: select complete display sets\nand rebase timestamps", fillcolor="#f3eaff"];
    pgs_hash [shape=diamond, label="Source/cut PGS payload hashes,\nsegment count and timing match?", fillcolor="#fff2cc"];
    pgs -> pgs_cut -> pgs_hash;
  }
  chapter [label="Rust: generate episode-relative\nchapters.txt, if configured", fillcolor="#fff2e2"];
  text [label="Rust: prepare ASS/SRT and\ncollect fonts, if configured", fillcolor="#fff2e2"];
  mux [label="mkvmerge: combine prepared tracks,\nchapters, fonts and tags", fillcolor="#dceeff"];
  partial [label="Temporary final MKV"];
  output [label="Publish episode MKV\nand optional audit.json", fillcolor="#ddf7e3", color="#72ad7d"];
  next [shape=diamond, label="More episodes?", fillcolor="#fff2cc"];
  repeat [label="Process next episode\nwith the same steps", fillcolor="#dceeff"];
  done [label="Batch complete", fillcolor="#ddf7e3"];

  toml -> plan -> cut;
  cut -> no_cut [label="no"];
  cut -> discover [label="yes"];
  discover -> marks -> probe -> bounds;
  bounds -> error [label="no"];
  bounds -> interval [label="yes"];
  interval -> video;
  interval -> audio;
  interval -> pgs [style=dashed];
  interval -> chapter [style=dashed];
  video_ok -> error [label="no"];
  audio_ok -> error [label="no"];
  video_ok -> mux [label="yes"];
  flac -> mux;
  pgs_hash -> error [label="no"];
  pgs_hash -> mux [label="yes"];
  chapter -> mux;
  text -> mux;
  mux -> partial -> output;
  output -> next;
  next -> done [label="no"];
  next -> repeat [label="yes"];
}
