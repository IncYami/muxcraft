flowchart TD
    A["Batch TOML: [episodes] entry"] --> B["Rust: load config, expand paths, build episode plan"]
    B --> C{"start_chapter present?"}
    C -- No --> NC["Use the configured source without cutting"]
    C -- Yes --> D["Rust: discover matching MPLS in BDMV/PLAYLIST"]
    D --> E["Rust: read 45 kHz chapter marks and select interval"]
    E --> F["ffprobe: inspect H.264, source start time and nearby keyframes"]
    F --> G{"Boundaries valid and within one frame of keyframes?"}
    G -- No --> ERR["Stop this episode and record the error"]
    G -- Yes --> INT["Resolved episode interval"]

    INT --> V["ffmpeg: copy the exact frame count from M2TS to a source-named MKV"]
    V --> VH["ffmpeg: compare source and cut video SHA-256 of H.264 picture units and packet count"]
    VH --> VG{"Video integrity passes?"}
    VG -- No --> ERR

    INT --> AU["ffmpeg: decode original M2TS audio; atrim interval; write PCM WAV"]
    AU --> AH["ffprobe + ffmpeg: select source M2TS samples independently by sample count; hash source and cut PCM"]
    AH --> AG{"Source and cut PCM hashes and byte counts match?"}
    AG -- No --> ERR
    AG -- Yes --> FL["flac: encode WAV with -8 and --verify"]

    INT --> PG{"PGS from shared M2TS configured?"}
    PG -- Yes --> PX["ffmpeg: extract complete PGS stream to SUP"]
    PX --> PC["Rust: select complete display sets and rebase timestamps"]
    PC --> PS["Episode SUP"]

    INT --> CH{"[chapters] configured?"}
    CH -- Yes --> CG["Rust: generate episode-relative chapters.txt"]

    VG -- Yes --> MX["mkvmerge: combine video, FLAC, subtitles, fonts, chapters and tags"]
    FL --> MX
    PS --> MX
    CG --> MX
    TEXT["Rust: prepare ASS/SRT and collect fonts when configured"] --> MX
    MX --> TMP["Temporary final MKV"]
    TMP --> FV["ffmpeg: compare source and final H.264 picture SHA-256 and packet count"]
    FV --> FA["ffmpeg: compare extracted PCM WAV and decoded final audio SHA-256 and byte count"]
    FA --> SY["ffprobe: compare first video/audio timestamps; tolerance 1 ms"]
    SY --> FP{"Episode PGS present?"}
    FP -- Yes --> PH["ffmpeg: compare extracted and final PGS packet SHA-256"]
    PH --> OK{"All checks pass?"}
    FP -- No --> OK
    OK -- No --> ERR
    OK -- Yes --> OUT["Publish episode MKV and audit.json"]
    OUT --> NEXT{"More episodes in batch?"}
    NEXT -- Yes --> REPEAT["Process the next episode with the same steps"]
    NEXT -- No --> DONE["Batch complete"]

    NC --> NCM["Standard mux path; outside this cut diagram"]
