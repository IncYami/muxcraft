flowchart TD
    A["Batch TOML: ordered file list in [episodes], no chapter cut"] --> B["Rust: resolve every clip and build the episode plan"]
    B --> C["Preflight: inspect clips and configured tracks"]
    C --> W["Create work/EP; report steps and commands in CLI"]
    W --> JOIN["mkvmerge: append clip 1 + clip 2 + ... without video encoding"]
    JOIN --> JFILE["Intermediate work/EP/first-source.joined.mkv"]
    JFILE --> VAR["{episodes} resolves to the joined MKV for configured tracks"]
    VAR --> V["VideoTrack: mkvmerge selects video from the joined MKV; no second video cut"]
    VAR --> AU{"AudioTrack configured?"}
    AU -- Yes --> AX["ffprobe identifies audio; ffmpeg extracts from its source: joined MKV for {episodes}"]
    AX --> AC{"FLAC requested?"}
    AC -- Yes --> FL["ffmpeg decodes to PCM when needed; flac encodes with -8 and --verify"]
    AC -- No --> CP["Use extracted original codec"]
    VAR --> PG{"PGS configured?"}
    PG -- Container --> PX["ffmpeg stream-copies PGS to SUP; {episodes} selects the joined MKV"]
    PG -- SUP file --> PD["Use the SUP file directly"]
    VAR --> OTHER["Additional VideoTrack sources keep their own paths"]
    W --> SUB["Rust: prepare ASS/SRT and collect fonts if enabled"]
    W --> CH["Rust: use a chapter file or explicit frame chapters"]
    W --> TAG["Rust: prepare optional track and TMDB tags"]
    V --> MX["mkvmerge: combine selected tracks, chapters, fonts and tags into a temporary MKV"]
    FL --> MX
    CP --> MX
    PX --> MX
    PD --> MX
    OTHER --> MX
    SUB --> MX
    CH --> MX
    TAG --> MX
    MX --> OUT["Publish final MKV without overwriting"]
    OUT --> CLEAN{"clean_work_dirs?"}
    CLEAN -- Yes --> RM["Remove work/EP, including the joined MKV"]
    CLEAN -- No --> KEEP["Keep joined MKV and other intermediates"]
    RM --> NEXT{"More episodes?"}
    KEEP --> NEXT
    NEXT -- Yes --> REPEAT["Process the next episode using its prebuilt plan"]
    NEXT -- No --> DONE["Batch complete"]
