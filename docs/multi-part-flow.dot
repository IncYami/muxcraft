digraph MultiPartFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.5", fontname="DejaVu Sans", label="Muxcraft: multi-part episode join", labelloc=t, fontsize=22, fontcolor="#14243a"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#8297b0", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.11"];
  edge [color="#64748b", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

  toml [label="Batch TOML\nordered [episodes] clip list; no cut", fillcolor="#dceeff"];
  plan [label="Rust: resolve clips and build\nthe episode plan"];
  preflight [label="Preflight: inspect clips\nand configured tracks"];
  work [label="Create work/EP; report steps\nand commands in CLI", fillcolor="#fff2e2"];
  join [label="mkvmerge: append clip 1 + clip 2 + ...\nwithout video encoding", fillcolor="#dceeff"];
  joined [label="Intermediate work/EP/\nfirst-source.joined.mkv", fillcolor="#e8f1ff"];
  variable [label="{episodes} resolves to joined MKV\nfor configured tracks", fillcolor="#dceeff"];
  video [label="VideoTrack: select video from joined MKV\nno second video cut", fillcolor="#e8f1ff"];
  audio [shape=diamond, label="AudioTrack\nconfigured?", fillcolor="#fff2cc"];
  extract [label="ffprobe identifies audio; ffmpeg\nextracts from its source\n(joined MKV for {episodes})", fillcolor="#e7f7ed"];
  flac_choice [shape=diamond, label="FLAC\nrequested?", fillcolor="#fff2cc"];
  flac [label="ffmpeg: decode to PCM when needed\nflac: -8 --verify", fillcolor="#e7f7ed"];
  copy [label="Use extracted original codec", fillcolor="#e7f7ed"];
  pgs [shape=diamond, label="PGS\nconfigured?", fillcolor="#fff2cc"];
  pgs_extract [label="ffmpeg: stream-copy PGS to SUP\n{episodes} selects joined MKV", fillcolor="#f3eaff"];
  pgs_direct [label="Use supplied SUP directly", fillcolor="#f3eaff"];
  other [label="Additional VideoTrack sources\nkeep their own paths"];
  subtitle [label="Rust: prepare ASS/SRT; collect\nfonts when enabled", fillcolor="#fff2e2"];
  chapter [label="Rust: chapter file or explicit\nframe chapters", fillcolor="#fff2e2"];
  tags [label="Rust: optional track and TMDB tags", fillcolor="#fff2e2"];
  mux [label="mkvmerge: combine tracks, chapters,\nfonts and tags into temporary MKV", fillcolor="#dceeff"];
  output [label="Publish MKV without overwriting", fillcolor="#ddf7e3", color="#72ad7d"];
  clean [shape=diamond, label="clean_work_dirs?", fillcolor="#fff2cc"];
  remove [label="Remove work/EP, including joined MKV"];
  keep [label="Keep joined MKV and intermediates"];
  next [shape=diamond, label="More episodes?", fillcolor="#fff2cc"];
  repeat [label="Process next episode\nusing its prebuilt plan", fillcolor="#dceeff"];
  done [label="Batch complete", fillcolor="#ddf7e3"];

  toml -> plan -> preflight -> work -> join -> joined -> variable;
  variable -> video;
  variable -> audio;
  audio -> extract [label="yes"];
  extract -> flac_choice;
  flac_choice -> flac [label="yes"];
  flac_choice -> copy [label="no"];
  variable -> pgs;
  pgs -> pgs_extract [label="container"];
  pgs -> pgs_direct [label="SUP file"];
  variable -> other;
  work -> subtitle;
  work -> chapter;
  work -> tags;
  video -> mux;
  audio -> mux [label="no"];
  flac -> mux;
  copy -> mux;
  pgs -> mux [label="no"];
  pgs_extract -> mux;
  pgs_direct -> mux;
  other -> mux;
  subtitle -> mux;
  chapter -> mux;
  tags -> mux;
  mux -> output -> clean;
  clean -> remove [label="yes"];
  clean -> keep [label="no"];
  remove -> next;
  keep -> next;
  next -> repeat [label="yes"];
  next -> done [label="no"];
}
