digraph SingleSourceFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.5", fontname="DejaVu Sans", label="Muxcraft: single-source episode mux", labelloc=t, fontsize=22, fontcolor="#14243a"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#8297b0", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.11"];
  edge [color="#64748b", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

  toml [label="Batch TOML\none [episodes] source; no cut", fillcolor="#dceeff"];
  plan [label="Rust: expand paths and build\nthe episode plan"];
  preflight [label="Preflight: check tools, sources, tracks,\nchapters and fonts"];
  work [label="Fetch TMDB tags before media work;\ncreate work/EP", fillcolor="#fff2e2"];
  video [label="VideoTrack: original source directly\nmkvmerge selects the video track", fillcolor="#e8f1ff"];
  audio [shape=diamond, label="AudioTrack\nconfigured?", fillcolor="#fff2cc"];
  extract [label="ffprobe identifies audio;\nffmpeg extracts selected stream", fillcolor="#e7f7ed"];
  flac_choice [shape=diamond, label="FLAC\nrequested?", fillcolor="#fff2cc"];
  pcm [label="ffmpeg: decode to PCM when needed\nflac: -8 --verify", fillcolor="#e7f7ed"];
  copy [label="mkvmerge: read audio directly\nfrom source container", fillcolor="#e7f7ed"];
  pgs [shape=diamond, label="PGS\nconfigured?", fillcolor="#fff2cc"];
  pgs_extract [label="ffmpeg: stream-copy container\nPGS track to SUP", fillcolor="#f3eaff"];
  pgs_direct [label="Use supplied SUP directly", fillcolor="#f3eaff"];
  subtitle [label="Rust: prepare ASS/SRT; collect\nmatching fonts when enabled", fillcolor="#fff2e2"];
  chapter [label="Rust: supplied chapters or OGM\nfrom frames/BDMV", fillcolor="#fff2e2"];
  tags [label="Rust: optional track tags", fillcolor="#fff2e2"];
  mux [label="mkvmerge: combine tracks, chapters,\nfonts and tags into temporary MKV", fillcolor="#dceeff"];
  verify [label="mkvmerge -J: verify structure;\nsync temporary MKV", fillcolor="#e0f4f4"];
  output [label="Publish MKV without overwriting", fillcolor="#ddf7e3", color="#72ad7d"];
  clean [shape=diamond, label="clean_work_dirs?", fillcolor="#fff2cc"];
  remove [label="Remove work/EP"];
  keep [label="Keep intermediates"];
  next [shape=diamond, label="More episodes?", fillcolor="#fff2cc"];
  repeat [label="Process next episode\nusing its prebuilt plan", fillcolor="#dceeff"];
  done [label="Batch complete", fillcolor="#ddf7e3"];

  toml -> plan -> preflight -> work;
  work -> video;
  work -> audio -> flac_choice [label="yes"];
  flac_choice -> extract [label="yes"];
  extract -> pcm;
  flac_choice -> copy [label="no"];
  work -> pgs;
  pgs -> pgs_extract [label="container"];
  pgs -> pgs_direct [label="SUP file"];
  work -> subtitle;
  work -> chapter;
  work -> tags;
  video -> mux;
  audio -> mux [label="no"];
  pcm -> mux;
  copy -> mux;
  pgs -> mux [label="no"];
  pgs_extract -> mux;
  pgs_direct -> mux;
  subtitle -> mux;
  chapter -> mux;
  tags -> mux;
  mux -> verify -> output -> clean;
  clean -> remove [label="yes"];
  clean -> keep [label="no"];
  remove -> next;
  keep -> next;
  next -> repeat [label="yes"];
  next -> done [label="no"];
}
